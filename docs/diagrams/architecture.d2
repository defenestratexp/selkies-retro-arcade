# Renders only inside the N9N d2 pipeline (filer icon library + lib/style.d2); docs/diagrams/architecture.png is the published image.
...@../../lib/style.d2
...@/mnt/n9n/assets/icons/d2/aws.d2
...@/mnt/n9n/assets/icons/d2/simple.d2
...@/mnt/n9n/assets/icons/d2/tabler.d2

vars: {d2-config: {layout-engine: dagre}}

direction: right
grid-columns: 2
grid-gap: 90

title: "Selkies retro arcade — architecture" {class: title}

lhs: "" {
  style: {fill: transparent; stroke: transparent}
  grid-columns: 1
  grid-gap: 90

  delivery: "Build + deploy" {
    class: zone
    grid-columns: 4
    grid-gap: 90
    vertical-gap: 20
    nas: "NAS\n(NFS export)" {class: [svc; tabler-server-2]}
    ansible: "Ansible role\nretro_arcade" {class: [svc; simple-ansible]}
    jenkins: "Jenkins\nbuild + smoke test" {class: [svc; simple-jenkins]}
    ecr: "Amazon ECR" {class: [svc; aws-amazonelasticcontainerregistry]}
    jenkins -> ecr: push image {class: flow}
  }

  host: "stream-host (Docker)" {
    class: zone
    direction: right
    disk: "/opt/retro on local disk\ngames (ro), roms (ro),\nstate (rw /config)" {class: [svc; tabler-database]}
    ctr: "retro-arcade container (:3000)" {
      class: subzone
      launch: "Launchers\nopenbox pipe menus,\nTk launcher" {class: [small; tabler-rocket]}
      apps: "Emulators and Wine\nRetroArch, MAME, ScummVM,\nDOSBox-X, Wine (i386)" {class: [svc; tabler-device-gamepad-2]}
      pulse: "PulseAudio\nnull sink" {class: [small; tabler-volume]}
      x: "Xvfb X server\n+ openbox desktop" {class: [small; tabler-device-desktop]}
      selkies: "Selkies\nWebRTC video +\npcmflux audio" {class: [svc; simple-webrtc]}
      launch -> apps: starts {class: flow}
      apps -> pulse: sound {class: flow}
      apps -> x: draws {class: flow}
      pulse -> selkies: capture {class: flow}
      x -> selkies: capture {class: flow}
    }
    disk -> ctr: bind mounts {class: flow}
  }
}

rhs: "" {
  style: {fill: transparent; stroke: transparent}
  direction: down
  user: "Browser\n(WebRTC client)" {class: [svc; tabler-browser]}
  edge: "Front door" {
    class: zone
    label.near: bottom-center
    cf: "Cloudflare Tunnel\n+ Access (optional,\npublic hostname)" {class: [svc; simple-cloudflare]}
    nginx: "nginx reverse proxy\nWebSocket upgrade,\nno buffering" {class: [svc; simple-nginx]}
    cf -> nginx: {style.opacity: 0}
  }
  user <-> edge.cf: "HTTPS / WSS" {class: flow}
  user <-> edge.nginx: "HTTPS / WSS\n(LAN)" {class: flow}
}

rhs.edge.nginx <-> lhs.host.ctr.selkies: "HTTP / WS" {class: flow}
rhs.edge.cf <-> lhs.host.ctr.selkies: "HTTP / WS" {class: flow}
lhs.delivery.ecr -> lhs.host.ctr: pull {class: flow}
lhs.delivery.ansible -> lhs.host: "session config,\ncompose up" {class: flow}
lhs.delivery.nas -> lhs.host.disk: "deploy-time only:\nmount, rsync, unmount" {class: flow}
