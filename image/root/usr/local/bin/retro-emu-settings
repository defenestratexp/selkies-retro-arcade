#!/bin/bash
# Open RetroArch's own settings GUI with this system's core loaded, so changes
# save as a PER-CORE override -- tweaking NES video does not disturb Genesis.
set -u
. /usr/local/bin/retro-audio-env
. /usr/local/bin/retro-systems

SYS="${1:-}"
CORE="$(retro_core_for "$SYS")"
[ -z "$CORE" ] && { echo "no core mapped for: $SYS"; exit 2; }

export HOME=/config
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/xdg-$(id -u)}"
mkdir -p "$XDG_RUNTIME_DIR" && chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null || true

exec retroarch --appendconfig "$RETRO_DRIVER_CFG" -L "$RETRO_CORE_DIR/$CORE" --menu
