#!/usr/bin/env python3
"""Add or remove entries in a system's Favorites / Confirmed Working list.

  retro-fav nes favorites add "<name>"         match by substring
  retro-fav nes working add "<name>"
  retro-fav nes hidden add "<name> (J)"         drop from the menu, keep the file
  retro-fav nes favorites remove "<name>"
  retro-fav nes favorites list

Lists are plain text (one ROM path relative to the system's ROM root). Editing
one takes effect on the next right-click -- no rebuild, no redeploy, no restart.
Copy semantics: a favourite still appears under All Games.
"""
import os, sys

ROM_ROOT  = "/roms"
LIST_ROOT = "/config/arcade"
EXTS = {
    "nes":      (".nes", ".zip"),
    "gameboy":  (".gb", ".gbc", ".zip"),
    "sms":      (".sms", ".7z", ".zip"),
    "genesis":  (".md", ".bin", ".gen", ".smd", ".zip"),
    "gamegear": (".gg", ".zip"),
}


def scan(system):
    root = os.path.join(ROM_ROOT, system)
    exts = EXTS.get(system, (".zip",))
    out = []
    for dp, d, fs in os.walk(root):
        d[:] = [x for x in d if x != "__MACOSX"]     # AppleDouble junk, not ROMs
        for f in fs:
            if f.startswith("._"):
                continue
            if f.lower().endswith(exts):
                out.append(os.path.relpath(os.path.join(dp, f), root))
    return sorted(out, key=str.lower)


def path_for(system, which):
    if which.startswith("collection:"):
        d = os.path.join(LIST_ROOT, system, "collections")
        os.makedirs(d, exist_ok=True)
        return os.path.join(d, which.split(":", 1)[1] + ".list")
    d = os.path.join(LIST_ROOT, system)
    os.makedirs(d, exist_ok=True)
    return os.path.join(d, which + ".list")


def read(p):
    if not os.path.exists(p):
        return []
    with open(p) as fh:
        return [l.strip() for l in fh if l.strip() and not l.startswith("#")]


def write(p, lines):
    with open(p, "w") as fh:
        fh.write("\n".join(lines) + ("\n" if lines else ""))


def main():
    if len(sys.argv) < 4:
        print(__doc__); sys.exit(2)
    system, which, action = sys.argv[1], sys.argv[2], sys.argv[3]
    term = sys.argv[4] if len(sys.argv) > 4 else ""
    if which not in ("favorites", "working", "hidden") and not which.startswith("collection:"):
        print("list must be 'favorites', 'working', 'hidden' or 'collection:<Name>'"); sys.exit(2)

    p = path_for(system, which)
    cur = read(p)

    if action == "list":
        print("%s / %s (%d):" % (system, which, len(cur)))
        for c in cur:
            print("  " + c)
        return

    if not term:
        print("need a search term"); sys.exit(2)

    if action == "add":
        hits = [r for r in scan(system) if term.lower() in r.lower()]
        if not hits:
            print("no ROM matches %r in %s" % (term, system)); sys.exit(1)
        if len(hits) > 1:
            exact = [h for h in hits if os.path.splitext(os.path.basename(h))[0].lower() == term.lower()]
            if len(exact) == 1:
                hits = exact
            else:
                print("%d matches -- be more specific:" % len(hits))
                for h in hits[:15]:
                    print("  " + h)
                sys.exit(1)
        if hits[0] in cur:
            print("already in %s: %s" % (which, hits[0])); return
        cur.append(hits[0]); write(p, cur)
        print("added to %s/%s: %s" % (system, which, hits[0]))

    elif action == "remove":
        keep = [c for c in cur if term.lower() not in c.lower()]
        if len(keep) == len(cur):
            print("nothing matching %r in %s/%s" % (term, system, which)); sys.exit(1)
        write(p, keep)
        print("removed %d entry(ies) from %s/%s" % (len(cur) - len(keep), system, which))
    else:
        print("action must be add, remove or list"); sys.exit(2)


if __name__ == "__main__":
    main()
